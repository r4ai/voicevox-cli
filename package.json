{
  "name": "@r4ai/voicevox-cli",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/r4ai/voicevox-cli.git"
  },
  "bin": {
    "voicevox": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "release:tag": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --project unit",
    "test:e2e": "pnpm build && vitest run --project e2e"
  },
  "dependencies": {
    "@gunshi/plugin-completion": "0.37.3",
    "@modelcontextprotocol/sdk": "1.30.1",
    "gunshi": "0.37.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.0"
}
